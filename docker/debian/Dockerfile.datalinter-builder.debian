# Debian (Trixie) Linux based commands

# WARNING!
#   The container needs to be run with --volume:build:/DataLinter/build
#   `docker run --rm --volume=./build:/DataLinter/build ghcr.io/zgornel/datalinter-builder:latest /julia/bin/julia /julia_app_builder/build.jl /DataLinter

FROM debian:trixie-slim
LABEL maintainer="zgornel"

RUN apt-get update && \
    apt-get -y install --no-install-recommends ca-certificates git wget gcc g++ jq curl make tar gzip libxml2 dpkg && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set up local folder structure and copy files for DataLinter
# (This assumes local directory is the root of DataLinter/)
# -----------------------------------------------------------
RUN mkdir -p /DataLinter/build \
             /output \
             /workspace \
             /tmp/test/data \
             /tmp/test/code \
WORKDIR /DataLinter
COPY ./.git ./.git/
COPY ./apps ./apps/
COPY ./src ./src/
COPY ./test ./test/
COPY ./config ./config
COPY ./knowledge ./knowledge
COPY ./workload ./workload
COPY ./Project.toml ./

# Install julia in /julia
WORKDIR /
RUN wget -q https://julialang-s3.julialang.org/bin/linux/x64/1.13/julia-1.13.1-linux-x86_64.tar.gz
RUN tar zxf julia-1.13.1-linux-x86_64.tar.gz
RUN ln -s /julia-1.13.1 /julia
RUN rm julia-1.13.5-linux-x86_64.tar.gz

# Install builder script
RUN git clone https://github.com/zgornel/julia_app_builder

# Cleanup operations
RUN apt-get -y autoclean
RUN apt-get -y autoremove

# Set up current directory to root
WORKDIR /
