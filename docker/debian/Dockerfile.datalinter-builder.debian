# Debian (Trixie) Linux based commands

# WARNING!
#   The container needs to be run with --volume:build:/DataLinter/build
#   `docker run --rm --volume=./build:/DataLinter/build ghcr.io/zgornel/datalinter-builder:latest /julia/bin/julia /datalinter_builder/build.jl /DataLinter
#
# Build context: the DataLinter root, filtered by
# Dockerfile.datalinter-builder.debian.dockerignore (excludes build/, docs/, gifs/).

FROM debian:trixie-slim
LABEL maintainer="zgornel"

# gcc/g++ are needed here (not in the runtime image): PackageCompiler links the
# sysimage and the app executables with them.
RUN apt-get update && \
    apt-get -y install --no-install-recommends ca-certificates git wget gcc g++ jq curl make tar gzip libxml2 dpkg && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install julia in /julia. Download, extract and delete in one layer, so the
# tarball is not kept in the image. Placed before the DataLinter sources, so
# local rebuilds after a source change reuse this layer.
WORKDIR /
RUN wget -q https://julialang-s3.julialang.org/bin/linux/x64/1.13/julia-1.13.1-linux-x86_64.tar.gz && \
    tar zxf julia-1.13.1-linux-x86_64.tar.gz && \
    rm julia-1.13.1-linux-x86_64.tar.gz && \
    ln -s /julia-1.13.1 /julia

# Install builder script: OxoaResearch/datalinter_builder (julia_app_builder with
# executables.toml support), cloned to /datalinter_builder (the path used by
# .github/workflows/ci.yml). Shallow clone of the default branch.
RUN git clone --depth 1 https://github.com/OxoaResearch/datalinter_builder /datalinter_builder

# Set up local folder structure and copy files for DataLinter
# (This assumes local directory is the root of DataLinter/)
# -----------------------------------------------------------
RUN mkdir -p /DataLinter/build \
             /output \
             /workspace \
             /tmp/test/data \
             /tmp/test/code
COPY ./.git/ /DataLinter/.git/
COPY ./apps /DataLinter/apps/
COPY ./src /DataLinter/src/
COPY ./test /DataLinter/test/
COPY ./config /DataLinter/config
COPY ./knowledge /DataLinter/knowledge
COPY ./workload /DataLinter/workload
COPY ./Project.toml /DataLinter/Project.toml

# Set up current directory to root
WORKDIR /
