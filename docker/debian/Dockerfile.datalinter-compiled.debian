# Debian (Trixie) Linux based commands

# Example run of the datalinter server
# `docker run -it --rm\
#       -p 10000:10000\
#       ghcr.io/zgornel/datalinter-compiled:latest\
#           /datalinterserver/bin/datalinterserver\
#               -i 0.0.0.0\
#               --config-path /datalinter/config/r_modelling_config.toml\
#               --log-level debug`

FROM debian:trixie-slim
LABEL org.opencontainers.image.source="https://github.com/zgornel/DataLinter"
LABEL maintainer="zgornel"

RUN apt-get update
RUN apt-get -y install --no-install-recommends ca-certificates git wget gcc g++ jq curl make tar gzip libxml2 dpkg

# Create directories, copy files
# ------------------------------

# Directories
RUN mkdir -p /_config \
             /_data \
             /_code \
             /output \
             /workspace \
             /datalinter/knowledge \
             /datalinter/config \
             /datalinterserver/knowledge \
             /datalinterserver/config \
             /tmp/test/data \
             /tmp/test/code \
             /root/dev/ \
             /root/src/

# Copy binaries
WORKDIR /
COPY ./build/datalinter /datalinter
COPY ./build/datalinterserver /datalinterserver
# Copy other files
COPY ./knowledge /datalinter/knowledge
COPY ./knowledge /datalinterserver/knowledge
COPY ./config /datalinter/config
COPY ./config /datalinterserver/config
COPY ./test/data /tmp/test/data
COPY ./test/code /tmp/test/code
COPY ./test/test_config.toml /tmp/test/test_config.toml

# Prime dependencies for top level script
# datalinter
RUN /datalinter/bin/datalinter /tmp/test/data/imbalanced_data.csv --code-path /tmp/test/code/r_snippet_imbalanced.r --config-path /tmp/test/test_config.toml --log-level debug > /dev/null
RUN /datalinter/bin/datalinter /tmp/test/data/correlated_data.csv --code-path /tmp/test/code/r_snippet_imbalanced.r --config-path /tmp/test/test_config.toml --log-level debug > /dev/null
RUN /datalinter/bin/datalinter /tmp/test/data/correlated_target_data.csv --code-path /tmp/test/code/r_snippet_binomial.r --config-path /tmp/test/test_config.toml --log-level debug > /dev/null

# datalinterserver (no priming)
RUN /datalinterserver/bin/datalinterserver -p 11000 -i 127.0.0.1 \
        --config-path /tmp/test/test_config.toml \
        --priming-data-path /tmp/test/data/correlated_data.csv \
        --priming-code-path /tmp/test/code/r_snippet_imbalanced.r \
        --log-level error &

# Entrypoint (from https://docs.docker.com/reference/dockerfile/#entrypoint)
### ENTRYPOINT ["/datalinter/bin/datalinter", "--kb-path /datalinter/knowledge/linting.toml", "--print-exceptions", "--log-level info", "-t"]

# Cleanup operations
RUN apt-get -y autoclean
RUN apt-get -y autoremove

# Set up current directory to root
WORKDIR /
